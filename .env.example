# Listd build-time configuration
#
# These values are passed via `--dart-define=KEY=VALUE` when running
# `flutter run` or `flutter build` (see README.md). They are NOT loaded
# from this file at runtime; this file just documents the required keys
# so a fresh checkout knows what to set.

# Supabase project URL — Dashboard → Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon public key — Dashboard → Settings → API → anon public
SUPABASE_ANON_KEY=your_anon_public_key

# Google OAuth Client ID — Google Cloud Console → APIs & Services →
# Credentials → OAuth 2.0 Client IDs (Desktop or Web client; identity only,
# no Google Tasks scope is requested).
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
